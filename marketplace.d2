direction: right
theme: 200  // optional; or pass --theme=200 via CLI

legend: {
  label: "Legend"
  StepFlow: "Edges labelled Step 0–7 map to the paper sections."
}

OnChain: {
  label: "Trust Boundary: On-Chain"
  Blockchain: "Blockchain (genesis includes λ, pp_new)"
  SC: "Smart Contract: Data Marketplace\n• records commitments (com_x, com_y)\n• stores requests & escrows\n• enforces deadlines / fairness"
}

OffChainActors: {
  label: "Trust Boundary: Off-Chain Actors"
  Creator: "Creator / Chain Deployer"
  Authority: "Data Authority"
  Contributor: "Data Contributor"
  Trainer: "Model Trainer"
}

Storage: {
  label: "Trust Boundary: Off-Chain Storage"
  IPFS: "IPFS"
}

SecureProto: {
  label: "Secure Channel"
  MPC: "Secure Data Scoring Protocol\n(MPC + ZK/commitments)\n— last message & output encrypted\n— on-chain submission required"
}

/* ------------ Public parameters ------------ */
Creator -> Blockchain: "Step 0: Deploy chain + embed λ, pp_new"
Creator -> SC: "Step 0: Deploy marketplace contract"

/* ------------ Request validation ------------ */
Contributor -> Authority: "Step 1: send (x, y) for validation"

Authority -> SC: "Step 2: commit com_x = Commit(pp_new, x), com_y = Commit(pp_new, y)"
Authority -> Contributor: "Step 3: send commitment randomness (r_x, r_y)"

/* ------------ Quote request / response ------------ */
Trainer -> SC: "Step 4: request quotes + com_M + escrow"
Contributor -> SC: "Step 5: submit (com_x, com_y) + escrow\n(must match Step 2 commitments)"

/* ------------ Fair secure scoring ------------ */
Contributor -> MPC: "Step 6: engage protocol (party A)"
Trainer -> MPC: "Step 6: engage protocol (party B)"
MPC -> SC: "Step 6: post encrypted last message + output (deadline-guarded)"

/* ------------ Data transaction (hash-locked) ------------ */
Contributor -> IPFS: "Step 7.1: upload Enc_k(data) → CID"
Contributor -> SC: "Step 7.2: post H(k)"
Contributor -> Trainer: "Step 7.3: send {CID, ZKP: encryption uses k}"
Trainer -> IPFS: "Step 7.4: fetch by CID; verify ZKP"
Trainer -> SC: "Step 7.5: post escrow"
Contributor -> SC: "Step 7.6: reveal k"
SC -> Contributor: "Step 7.7: release escrow"
Trainer -> IPFS: "Step 7.8: decrypt with k → data"

/* ------------ Light layout hints (optional) ------------ */
Blockchain -> SC
Authority -> Contributor
