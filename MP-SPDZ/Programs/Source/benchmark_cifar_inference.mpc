# Benchmark secure inference: P0 has data, P1 has model weights
# Simple CNN with one Conv2d + ReLU + MaxPool2d layer

program.options_from_args()

import time
from Compiler import ml
# Reduce precision to use fewer triples and improve benchmark accuracy
from Compiler.types import sfix
sfix.set_precision(f=8, k=20)  # Lower precision than default

# Set number of threads for performance
try:
    ml.set_n_threads(int(program.args[1]))
except:
    ml.set_n_threads(16)

try:
    batch_size = int(program.args[2])
except:
    batch_size = 10

import torchvision
import torch
import torch.nn as nn
import numpy

print_ln("Starting secure CIFAR-10 inference benchmark...")

# Step 1: Load CIFAR-10 dataset from P0
print_ln("Step 1: Loading CIFAR-10 dataset from P0...")
start_time = time.time()

# Only load test set for inference
ds = torchvision.datasets.CIFAR10(root='/tmp', train=False, download=True)

# Take a subset for benchmarking (adjust as needed)
subset_size = min(batch_size, len(ds.data))  # Use first 100 samples for benchmark
test_data = ds.data[:subset_size]

# Normalize to [-1,1] and input via P0
test_samples = sfix.input_tensor_via(0, test_data / 255 * 2 - 1, binary=True)

data_load_time = time.time() - start_time
print_ln("Data loading completed in %s seconds", data_load_time)

# Step 2: Define model architecture and load weights from P1
print_ln("Step 2: Creating model and loading weights from P1...")
start_time = time.time()

# Define a smaller model to reduce triple usage
net = nn.Sequential(
    nn.Conv2d(3,32, kernel_size=3,padding=1) ,
    nn.ReLU(),
    nn.Flatten(),
    nn.Linear(32*32*32,1)
)

# Initialize with random weights for this benchmark
# In practice, P1 would have pre-trained weights
torch.manual_seed(42)  # For reproducible results
for layer in net:
    if hasattr(layer, 'weight'):
        nn.init.xavier_uniform_(layer.weight)
    if hasattr(layer, 'bias') and layer.bias is not None:
        nn.init.zeros_(layer.bias)

# Convert to MP-SPDZ layers with weights input via P1
layers = ml.layers_from_torch(net, test_samples.shape, batch_size, input_via=1)

model_load_time = time.time() - start_time
print_ln("Model loading completed in %s seconds", model_load_time)

# Step 3: Perform secure inference
print_ln("Step 3: Performing secure inference...")
start_time = time.time()

optimizer = ml.Optimizer(layers)

# Perform inference
predictions = optimizer.eval(test_samples).get_vector()
predictions = ml.relu(predictions)   # Add activation here

inference_time = time.time() - start_time
print_ln("Secure inference completed in %s seconds", inference_time)

# Step 4: Reveal results only to P0
print_ln("Step 4: Revealing results to P0...")
start_time = time.time()

# Reveal predictions to P0 only
revealed_predictions = predictions.reveal_to(0)

reveal_time = time.time() - start_time
print_ln("Results revelation completed in %s seconds", reveal_time)

# Total benchmark time
total_time = data_load_time + model_load_time + inference_time + reveal_time
print_ln("")
print_ln("=== BENCHMARK RESULTS ===")
print_ln("Dataset size: %s samples", subset_size)
print_ln("Batch size: %s", batch_size)
print_ln("")
print_ln("Timing breakdown:")
print_ln("  Data loading (P0): %s seconds", data_load_time)
print_ln("  Model loading (P1): %s seconds", model_load_time)
print_ln("  Secure inference: %s seconds", inference_time)
print_ln("  Result revelation (to P0): %s seconds", reveal_time)
print_ln("  Total time: %s seconds", total_time)
print_ln("")
print_ln("Benchmark completed successfully!")