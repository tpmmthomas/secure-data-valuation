# test_conv_only.mpc
program.options_from_args()

import time
from Compiler import ml
from Compiler.types import sfix

sfix.set_precision(f=8, k=24)

try:
    batch_size = int(program.args[1])
except:
    batch_size = 8

print_ln("Standalone Conv2d: data from P0 file (NumPy/Torch), weights+bias from P1")

# ---------------- Load & prep data (P0) ----------------
import numpy as np
import torch

t0 = time.time()
pth = "/home/thomas/secure-data-valuation/experiments/data/rep_points.pth"

# Try to load the tensor with error handling
try:
    raw = torch.load(pth, map_location="cpu")
except Exception as e:
    print_ln("Error loading torch file: %s", str(e))
    # Create a dummy tensor for testing - MNIST-like 1 channel data
    print_ln("Creating dummy MNIST-like data for testing")
    raw = torch.randn(1, 1, 28, 28)  # NCHW format: 1 sample, 1 channel, 28x28

# keep your previous "skip first" behavior
if isinstance(raw, (np.ndarray, torch.Tensor)) and getattr(raw, "shape", None) and raw.shape[0] >= 2:
    raw = raw[:1]
print(raw.shape)

# Convert to numpy
if isinstance(raw, np.ndarray):
    arr = raw
elif isinstance(raw, torch.Tensor):
    arr = raw.detach().cpu().numpy()
elif isinstance(raw, (list, tuple)) and len(raw) > 0:
    # stack a list of arrays/tensors
    def to_np(x):
        if isinstance(x, np.ndarray): return x
        if isinstance(x, torch.Tensor): return x.detach().cpu().numpy()
        return np.array(x)
    arr = np.stack([to_np(x) for x in raw], axis=0)
else:
    raise RuntimeError("Unsupported rep_points format; expected ndarray / tensor / list of them")

# Ensure float32 and normalize to [-1, 1]
arr = arr.astype(np.float32, copy=False)
if np.nanmax(arr) > 1.0 + 1e-6:  # looks like 0..255
    arr /= 255.0
arr = arr * 2.0 - 1.0

# Expecting NCHW; convert to NHWC if needed
# Heuristic: if channel is axis 1 (common NCHW) and last axis isn't 1/3, transpose
if arr.ndim != 4:
    raise RuntimeError(f"Expected 4D tensor, got shape {arr.shape}")
N, A, B, C = arr.shape  # ambiguous until we decide layout

print_ln("Tensor shape before layout conversion: [%s, %s, %s, %s]", N, A, B, C)

if A in (1, 3) and arr.shape[-1] not in (1, 3):
    # NCHW -> NHWC
    print_ln("Converting from NCHW to NHWC")
    arr = arr.transpose(0, 2, 3, 1)
# else assume already NHWC

Bsz = min(batch_size, arr.shape[0])
x_nhwc = arr[:Bsz]  # [B,H,W,C]
B_, H, W, Cin = x_nhwc.shape

print_ln("Final tensor shape NHWC: [%s, %s, %s, %s]", B_, H, W, Cin)

print(x_nhwc.shape)

from Compiler.types import sfix
X = sfix.input_tensor_via(0, x_nhwc)  # input from P0

#print_ln("Loaded %s samples from file (P0). Shape NHWC: [%s,%s,%s,%s]", B_, H, W, Cin)
print_ln("Data prep time: %s s", time.time() - t0)

# ---------------- Build single Conv2d ----------------
out_ch = 3
k = 5

print_ln("Setting up Conv2d with:")
print_ln("  Input shape: [%s, %s, %s, %s] (NHWC)", B_, H, W, Cin)
print_ln("  Output channels: %s", out_ch)
print_ln("  Kernel size: %s", k)
print_ln("  Expected weight shape: [%s, %s, %s, %s] (k, k, Cin, out_ch)", k, k, Cin, out_ch)

conv = ml.easyConv2d(
    input_shape=[B_, H, W, Cin],  # NHWC
    batch_size=B_,
    out_channels=out_ch,
    kernel_size=k,
    stride=1,
    padding='VALID',              # H_out = H-k+1, W_out = W-k+1
    tf_weight_format=True         # weights as [k, k, Cin, out_ch]
)

# Wire inputs
conv.X.assign(X)

# Read weights then bias from P1 (exact order!)
# W size = k*k*Cin*out_ch, b size = out_ch
conv.input_from(1)

# ---------------- Forward ----------------
opt = ml.Optimizer([conv])
opt.forward(N=B_)

Y = conv.Y  # [B_, H_out, W_out, out_ch]

# reveal a few values for sanity
flat = Y.get_vector().reveal_to(0)

